# ==============================================================
# Variables d'environnement pour ZAYNA Backend (Docker & Local)
# ==============================================================

# Clé secrète JWT obligatoire (minimum 32 caractères)
JWT_SECRET=zayna_super_secret_jwt_key_2026_at_least_32_chars!

# Administrateur initial (créé automatiquement au 1er démarrage)
# Le mot de passe doit contenir: 8-64 caractères, 1 majuscule, 1 minuscule, 1 chiffre, 1 caractère spécial
ADMIN_EMAIL=admin@zayna.com
ADMIN_USERNAME=admin_zayna
ADMIN_PASSWORD=AdminZayna2026!

# Autorisation CORS
CORS_ALLOWED_ORIGINS=*

# Envoi d'e-mails (mode dev : affiche les liens de réinitialisation dans la console Docker/Spring Boot)
MAIL_DEV_LOG_LINKS=true
